// Phase 4 step 0: control-channel spike (ADR 0003). An AudioDriverKit driver
// that matches IOUserResources and publishes custom properties on the driver
// object, with no audio device until a client asks for one. It never touches
// USB hardware.

#ifndef ControlSpike_h
#define ControlSpike_h

#include <Availability.h>
#include <DriverKit/IOService.iig>
#include <DriverKit/IOTimerDispatchSource.iig>
#include <AudioDriverKit/IOUserAudioDriver.iig>

class ControlSpike: public IOUserAudioDriver
{
public:
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t Start(IOService * provider) override;
    virtual kern_return_t Stop(IOService * provider) override;
    // Creates ControlSpikeUserClient for type 'xlrc'; every other type goes to AudioDriverKit.
    virtual kern_return_t NewUserClient(uint32_t in_type, IOUserClient ** out_user_client) override;

    // Runs a write to the command property. Returns the result the client sees.
    kern_return_t HandleCommand(OSObject * data) LOCALONLY;

    virtual void EventTimerFired(OSAction * action, uint64_t time) TYPE(IOTimerDispatchSource::TimerOccurred);
};

#endif /* ControlSpike_h */
